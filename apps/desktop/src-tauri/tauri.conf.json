{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrostWalker",
  "version": "0.3.0",
  "identifier": "com.frostwalker.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FrostWalker",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#f6f6f3"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://api.modrinth.com",
        "img-src": "'self' asset: http://asset.localhost https://cdn.modrinth.com https://render.crafty.gg data: blob:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A fast, approachable Minecraft launcher",
    "longDescription": "FrostWalker combines a calm native launcher with Modrinth discovery and curated performance profiles.",
    "copyright": "Copyright © 2026 Yannis Ress Lasser",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
